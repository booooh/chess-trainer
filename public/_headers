# Cloudflare Pages response headers (ADR-0009). Not served itself.
# Everything else gets Cloudflare's default (revalidate on every request), which is what
# index.html, sw.js and manifest.webmanifest need so that updates reach the phone.

# Vite puts a content hash in every filename under /assets/, so a file there never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
